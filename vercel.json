{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"fluid": true,
	"installCommand": "npm ci",
	"buildCommand": "npm run build:static",
	"ignoreCommand": "[ ! -f tools/apple-pow-tables.ts ] && grep -q 'from \"./apple-pow-tables' tools/fdlibm.ts && echo 'Skipped: tools/apple-pow-tables.ts is not in git; deploy from the dev Mac (docs/DEPLOY.md)'",
	"outputDirectory": "dist",
	"cleanUrls": true,
	"functions": {
		"api/ai/*.mjs": {
			"maxDuration": 300,
			"supportsCancellation": true,
			"includeFiles": "{ai/**,web/sim/**/*.js,web/sim/**/*.json}",
			"excludeFiles": "web/sim/**/*.map"
		},
		"api/scenes/*.mjs": {
			"maxDuration": 30,
			"includeFiles": "{web/sim/**/*.js,web/sim/**/*.json}",
			"excludeFiles": "web/sim/**/*.map"
		}
	},
	"rewrites": [
		{ "source": "/api/scenes/:id", "destination": "/api/scenes" },
		{ "source": "/api/scenes/:id/:part", "destination": "/api/scenes" }
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{ "key": "X-Content-Type-Options", "value": "nosniff" },
				{ "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
			]
		},
		{
			"source": "/((?!vendor/|api/).*)",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
		},
		{
			"source": "/vendor/(.*)",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
		},
		{
			"source": "/(.*)\\.(js|mjs)",
			"headers": [{ "key": "Content-Type", "value": "text/javascript; charset=utf-8" }]
		}
	]
}
