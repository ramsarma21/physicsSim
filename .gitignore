# Apple-libm-derived pow constants: no longer used (pow is tools/crpow.ts, written for this project); never commit a copy
tools/apple-pow-tables.ts
# (and pow.patch / pow-files/ if ever copied here: their diffs still hold the removed Apple-derived pow)
/pow.patch
/pow-files/

# generated caches
ai/.cache/
